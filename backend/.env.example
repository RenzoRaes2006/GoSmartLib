# Voorbeeld-secrets. Kopieer dit bestand naar `.env` (zelfde map) en vul de
# echte waarden in. `.env` staat in .gitignore en mag NOOIT op git komen.
#   cp .env.example .env

# Smartschool OAuth2
SMARTSCHOOL_CLIENT_ID=
SMARTSCHOOL_CLIENT_SECRET=

# OneRoster API
ONEROSTER_USERNAME=
ONEROSTER_PASSWORD=

# Initieel admin-wachtwoord (alleen bij eerste boot; daarna verplicht wijzigen).
# Laat leeg in productie om de seed over te slaan.
ADMIN_INITIAL_PASSWORD=

# Google Books API-sleutel (voor het zoeken van boeken op ISBN).
GOOGLE_BOOKS_API_KEY=
